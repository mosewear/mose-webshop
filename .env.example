# Environment Variables Template
# Copy this to .env.local and fill in your actual values

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# SendCloud
SENDCLOUD_PUBLIC_KEY=""
SENDCLOUD_SECRET_KEY=""

# Supabase (REQUIRED for checkout!)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Other
CRON_SECRET=""
INTERNAL_API_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_POSTHOG_HOST="https://eu.posthog.com"
NEXT_PUBLIC_POSTHOG_KEY=""
RESEND_API_KEY=""

# Trustpilot
# Unique Automatic Feedback Service (AFS) BCC address. Found in Trustpilot
# Business portal > Get reviews > Invitation settings > BCC method. When set,
# our "order delivered" e-mail BCCs this address so Trustpilot fires its own
# review invitation after the delay configured in the Trustpilot portal.
# Leave empty to disable Trustpilot invitations entirely.
TRUSTPILOT_AFS_BCC_EMAIL=""
# Optional: used by the footer widget to decide when to show the Trustpilot
# rating badge. The widget only renders once we hit this threshold.
TRUSTPILOT_REVIEW_COUNT="0"
TRUSTPILOT_MIN_REVIEWS="30"

# Instagram Feed (managed via /admin/instagram).
# Token + business account id are stored in the instagram_credentials
# table; only the Meta app credentials live in env so the monthly
# token-refresh cron can call /oauth/access_token. Both optional —
# without them, /api/instagram/refresh-token returns 503 cleanly and
# you can still paste a fresh token by hand in /admin/instagram.
META_APP_ID=""
META_APP_SECRET=""

# Meta Conversions API + Marketing API (AI Campaign Autopilot)
# FACEBOOK_ACCESS_TOKEN is the Pixel/CAPI access token used by both the
# client-proxied /api/facebook-capi route and the server-side Purchase
# event fired from the Stripe webhook. Generate this in Meta Events
# Manager > Settings > Conversions API > Generate access token.
FACEBOOK_ACCESS_TOKEN=""
# Meta Pixel ID (Events Manager). Was previously hard-coded; lift to env
# so non-prod environments can target a test pixel.
NEXT_PUBLIC_META_PIXEL_ID="1447430483627328"
# Meta Marketing API: business + ad account targeted by the autopilot.
# Find these in Business Suite > Settings. ad_account_id is prefixed
# with "act_" when calling the API (the wrapper handles this).
META_BUSINESS_ID=""
META_AD_ACCOUNT_ID=""
# System User token from your Meta Business Developer App. Scopes:
# ads_management, ads_read, business_management. Non-expiring.
META_SYSTEM_USER_TOKEN=""

# AI providers (used by the autopilot reasoning + creative pipeline)
# OpenAI is the primary reasoning engine (function calling, copy gen).
OPENAI_API_KEY=""
# Anthropic is optional, used for long-context monthly creative audits.
ANTHROPIC_API_KEY=""
# Replicate hosts BiRefNet (segmentation) and Flux Kontext / Seedream
# (garment-preserving image edit). Required for Phase 3 creative pipeline.
REPLICATE_API_TOKEN=""
